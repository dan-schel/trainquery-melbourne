{
  "type": "module",
  "dependencies": {
    "@dan-schel/js-utils": "4.14.1",
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.8",
    "@vitest/coverage-v8": "5.0.2",
    "adm-zip": "0.6.1",
    "chalk": "6.0.0",
    "corequery": "0.23.0",
    "corequery-gtfs": "0.10.3",
    "csv-parser": "3.2.1",
    "dotenv": "17.4.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "temporal-polyfill": "1.0.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev-corequery-demo-app": "tsx watch --clear-screen=false --exclude ../node_modules src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit && eslint . --max-warnings 0 && knip",
    "test": "vitest --run",
    "test-coverage": "vitest --run --coverage",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "compare-config-to-gtfs": "tsx scripts/compare-config-to-gtfs/main.ts",
    "download-gtfs": "tsx scripts/download-gtfs/main.ts",
    "import-stop-from-gtfs": "tsx scripts/import-stop-from-gtfs/main.ts",
    "generate-gtfs-integration-test": "tsx scripts/generate-gtfs-integration-test/main.ts"
  },
  "corequeryDemoApp": {
    "scripts": {
      "dev": "dev-corequery-demo-app",
      "start": "start"
    },
    "environmentVariables": [
      {
        "name": "DATABASE_URL"
      },
      {
        "name": "VTAR_KEY"
      }
    ]
  }
}
